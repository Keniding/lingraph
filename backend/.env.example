# Copia este archivo a .env y rellena los valores reales.
# .env está en .gitignore — nunca se commitea.

# Base de datos (SQLite en local; Postgres en prod)
DATABASE_URL=sqlite:///./lingraph.db

# Clave aleatoria para firmar la cookie de sesión del flujo OAuth.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me

# Credenciales de "Sign in with LinkedIn" (OpenID Connect).
# Crea una app en https://www.linkedin.com/developers/ y agrega el
# producto "Sign In with LinkedIn using OpenID Connect".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
